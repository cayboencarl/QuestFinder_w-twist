# Copy this file to .env and fill in your own values. Never commit .env.

# --- Flask -------------------------------------------------------------
FLASK_APP=run.py
FLASK_ENV_NAME=development
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL ---------------------------------------------------------
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://questfinder:your-db-password@localhost:5432/questfinder

# --- Seed / admin accounts (used by `flask seed`) -----------------------
ADMIN_EMAIL=admin@questfinder.test
ADMIN_PASSWORD=change-me-admin-pass
SEED_USER_PASSWORD=change-me-demo-pass

# --- Business rules ------------------------------------------------------
# true = posting, accepting quests and wallet use need an approved ID + face verification
REQUIRE_VERIFICATION=true
# Max face-descriptor distance accepted as a match (lower = stricter)
FACE_MATCH_THRESHOLD=0.55

# --- Map (Barangay San Vicente, Baguio City) ------------------------------
DEFAULT_MAP_LAT=16.3954
DEFAULT_MAP_LNG=120.5968
DEFAULT_MAP_ZOOM=16
APPROX_LOCATION_METERS=300
DEFAULT_RADIUS_KM=5
# Only allow quests pinned inside Brgy. San Vicente (true/false)
RESTRICT_QUESTS_TO_BARANGAY=true
# Map tiles for Leaflet (default: OpenStreetMap standard tiles)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Uploads & sessions -----------------------------------------------------
MAX_UPLOAD_MB=8
SESSION_HOURS=12
# Set to true when serving over HTTPS
SESSION_COOKIE_SECURE=false
